        public static int? UpdateStudent(Student student, string oldEmail)
{
    int? result = null;

    if (student == null || string.IsNullOrWhiteSpace(oldEmail))
    {
        Debug.WriteLine("El objeto student es nulo o el oldEmail está vacío.");
        return null;
    }

    try
    {
        using var connection = Singleton1.GetConnection();
        if (connection.State != System.Data.ConnectionState.Open)
            connection.Open();

        // 1) Verificar que el estudiante existe con el correo viejo
         string checkSql = @"
            SELECT COUNT(*) 
            FROM school.students 
            WHERE email = @oldEmail;
        ";
        using (var checkCmd = new MySqlCommand(checkSql, connection))
        {
            checkCmd.Parameters.AddWithValue("@oldEmail", oldEmail.Trim());
            int count = Convert.ToInt32(checkCmd.ExecuteScalar());
            if (count == 0)
            {
                Debug.WriteLine($"No existe el email antiguo en students: {oldEmail}");
                return null;
            }
        }

        // 2) Ejecutar UPDATE en tabla `students`
        const string updateSql = @"
            UPDATE school.students 
            SET first_name = @firstName,
                last_name = @lastName,
                birth_day = @birthDay,
                email = @newEmail,
                phone = @phone,
                date_entry = @dateEntry,
                status = @status
            WHERE email = @oldEmail;
        ";
        using var updateCmd = new MySqlCommand(updateSql, connection);
        updateCmd.Parameters.AddWithValue("@firstName", student.FirstName?.Trim());
        updateCmd.Parameters.AddWithValue("@lastName", student.LastName?.Trim());
        updateCmd.Parameters.AddWithValue("@birthDay", student.BirthDate);
        updateCmd.Parameters.AddWithValue("@newEmail", student.Email?.Trim());
        updateCmd.Parameters.AddWithValue("@phone", student.Phone?.Trim());
        updateCmd.Parameters.AddWithValue("@dateEntry", student.DateEntry);
        updateCmd.Parameters.AddWithValue("@status", (short)student.Status); // Asegúrate que el enum se mapea a short
        updateCmd.Parameters.AddWithValue("@oldEmail", oldEmail.Trim());

        result = updateCmd.ExecuteNonQuery();
    }
    catch (MySqlException mex)
    {
        Debug.WriteLine($"MySQL Error en UpdateStudent: {mex.Message}");
    }
    catch (Exception ex)
    {
        Debug.WriteLine($"Error general en UpdateStudent: {ex.Message}");
    }
   
    return result;
}


﻿using System;
using System.Web;
using SistemsProyect.Model.Classes;
using SistemsProyect.Model.DataBase.Controllers;
using SistemsProyect.Model.Enums;

namespace SistemsProyect.Components.Pages.Actions.Admin.ViewsButton.AdminStudent.Views
{
    public partial class SearchStudent : System.Web.UI.UserControl
    {
        protected void Page_Load(object sender, EventArgs e)
        {
            if (!IsPostBack)
            {
                // Inicializar controles si es necesario
                rbSearchByPhone.Checked = true;
            }
        }

        protected void btnSearch_Click(object sender, EventArgs e)
        {
            try
            {
                string searchTerm = txtSearchTerm.Text.Trim();

                if (string.IsNullOrEmpty(searchTerm))
                {
                    // ShowMessage("Ingrese un término de búsqueda", "text-danger");
                    message.Text = "Ingrese un término de búsqueda";
                    message.CssClass = "text-danger";
                    return;
                }

                int? result = null;
                if (rbSearchByPhone.Checked)
                {
                    // Buscar por teléfono
                    result = StudentOperations.GetStudentByPhone(searchTerm);
                }
                else if (rbSearchByEmail.Checked)
                {
                    // Buscar por email
                    result = StudentOperations.GetStudentByEmail(searchTerm);
                }

                int i = 0;
                if (result > 0)
                {
                    // User user = (User)HttpContext.Current.Session["user"];
                    Student student = (Student)HttpContext.Current.Session["student"];
                    // Mostrar datos del estudiante encontrado
                    DisplayStudentData(student);
                    // ShowMessage("Estudiante encontrado", "text-success");
                    pnlEditStudent.Visible = true;
                    var page = (AdminViewStudents)this.Page;
                    page.SearchStudentView();
                }
                else
                {
                    pnlEditStudent.Visible = false;
                    ClearStudentData();
                    // ShowMessage("No se encontró ningún estudiante", "text-danger");
                }
            }
            catch (Exception ex)
            {
                ClearStudentData();
                // ShowMessage($"Error al buscar: {ex.Message}", "text-danger");
                message.Text = $"Error al buscar: {ex.Message}";
                message.CssClass = "text-danger";
            }
        }

        protected void btnSave_Click(object sender, EventArgs e)
        {
            try
            {
                if (!ValidateStudentData())
                {
                    // ShowMessage("Complete todos los campos requeridos", "text-danger");
                    return;
                }

                var student = new Student
                {
                    Id = int.Parse(txtID.Text),
                    FirstName = txtFirstName.Text.Trim(),
                    LastName = txtLastName.Text.Trim(),
                    Email = txtEmail.Text.Trim(),
                    Phone = txtPhone.Text.Trim(),
                    BirthDate = DateTime.Parse(txtBirthDate.Text),
                    DateEntry = DateTime.Parse(txtDateEntry.Text),
                    Status = (StudentStatus)Enum.Parse(typeof(StudentStatus), ddlStatus.SelectedValue)
                };
                string email = txtEmail.Text.Trim();
                int? success = StudentOperations.UpdateStudent(student, email);

                if (success > 0)
                {
                    // ShowMessage("Estudiante actualizado correctamente", "text-success");
                    message.Text = "Estudiante actualizado correctamente";
                    message.CssClass = "text-success";
                }
                else
                {
                    // ShowMessage("Error al actualizar el estudiante", "text-danger");
                    message.Text = "Error al actualizar el estudiante";
                    message.CssClass = "text-danger";
                }
            }

            catch (Exception ex)
            {
                // ShowMessage($"Error al guardar: {ex.Message}", "text-danger");
            }
        }

        private void DisplayStudentData(Student student)
        {
            txtID.Text = student.Id.ToString();
            txtFirstName.Text = student.FirstName;
            txtLastName.Text = student.LastName;
            txtEmail.Text = student.Email;
            txtPhone.Text = student.Phone;
            var helper = Convert.ToDateTime(student.BirthDate.ToString());
            txtBirthDate.Text = helper.ToShortDateString();
            helper = Convert.ToDateTime(student.DateEntry.ToString());
            txtDateEntry.Text = helper.ToShortDateString();
            ddlStatus.SelectedValue = student.Status.ToString();
        }

        private void ClearStudentData()
        {
            txtID.Text = string.Empty;
            txtFirstName.Text = string.Empty;
            txtLastName.Text = string.Empty;
            txtEmail.Text = string.Empty;
            txtPhone.Text = string.Empty;
            txtBirthDate.Text = string.Empty;
            txtDateEntry.Text = string.Empty;
            ddlStatus.SelectedIndex = 0;
        }

        private bool ValidateStudentData()
        {
            return !string.IsNullOrEmpty(txtFirstName.Text) &&
                   !string.IsNullOrEmpty(txtLastName.Text) &&
                   !string.IsNullOrEmpty(txtEmail.Text) &&
                   !string.IsNullOrEmpty(txtPhone.Text) &&
                   !string.IsNullOrEmpty(txtBirthDate.Text) &&
                   !string.IsNullOrEmpty(txtDateEntry.Text) &&
                   ddlStatus.SelectedIndex > 0;
        }


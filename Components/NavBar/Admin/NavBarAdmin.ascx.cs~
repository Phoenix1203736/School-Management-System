using System;
using System.Web.UI;
using System.Web.UI.WebControls;

namespace SistemsProyect.Components.NavBar.Admin
{
    public partial class NavBarAdmin : UserControl
    {
        protected void Page_Load(object sender, EventArgs e)
        {
            FillDropDown();
        }

        public void FillDropDown()
        {
            if (!IsPostBack)
            {
                dropdownManageOptions.ClearSelection();

                dropdownManageOptions.Items.Add(new ListItem("Administrar") { Enabled = true });
                dropdownManageOptions.Items.Add(new ListItem("Administrar Alumnos") { Enabled = true });
                dropdownManageOptions.Items.Add(new ListItem("Administrar Profesores") { Enabled = true });
                dropdownManageOptions.Items.Add(new ListItem("Administrar Cursos") { Enabled = true });
                dropdownManageOptions.Items.Add(new ListItem("Reportes") { Enabled = true });
            }
        }

        protected void dropdownManageOptions_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (dropdownManageOptions.SelectedItem.Text == "Administrar Alumnos")
            {
                if (Session["Teachers"] != null) Session.Remove("Teachers");
                if (Session["Courses"] != null) Session.Remove("Courses");
                if (Session["Reports"] != null) Session.Remove("Reports");
                Session["Students"] = true;
                Response.Redirect(ResolveUrl("~/Components/Pages/Actions/Admin/ViewsButton/AdminStudent/AdminViewStudents.aspx"));
            }

            if (dropdownManageOptions.SelectedItem.Text == "Administrar Profesores")
            {
                if (Session["Student"] != null) Session.Remove("Student");
                if (Session["Courses"] != null) Session.Remove("Courses");
                if (Session["Reports"] != null) Session.Remove("Reports");
                Session["Teachers"] = true;
                Response.Redirect(ResolveUrl("~/Components/Pages/Actions/Admin/ViewsButton/Teacher/AdminView.aspx"));
            }

            if (dropdownManageOptions.SelectedItem.Text == "Administrar Cursos")
            {
                if (Session["Student"] != null) Session.Remove("Student");
                if (Session["Teachers"] != null) Session.Remove("Teachers");
                if (Session["Reports"] != null) Session.Remove("Reports");

                Session["Courses"] = true;
                Response.Redirect(ResolveUrl("~/Components/Pages/Actions/Admin/ViewsButton/AdminCourses/AdminViewCourses.aspx"));
            }

            if (dropdownManageOptions.SelectedItem.Text == "Reportes")
            {
                if (Session["Student"] != null) Session.Remove("Student");
                if (Session["Teachers"] != null) Session.Remove("Teachers");
                if (Session["Courses"] != null) Session.Remove("Courses");
                Session["Reports"] = true;
                Response.Redirect(ResolveUrl("~/Components/Pages/Admin/AdminReports/AdminViewReports.aspx"));
            }
        }

        protected void buttonSignOut_Click(object sender, EventArgs e)
        {
            Session.Clear();
            Response.Redirect(ResolveUrl("~/Default.aspx"));
        }
    }
}